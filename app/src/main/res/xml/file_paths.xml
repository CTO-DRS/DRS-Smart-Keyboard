<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="backup"
        path="backup-and-restore/"/>
    <cache-path
        name="downloads"
        path="downloads/"/>
    <!-- «الشفافية والتعلم» (ADR-0009 — نقطة قرار المالك 2): شهادة العمر
