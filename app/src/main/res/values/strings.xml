    <!-- About -->
    <string name="about_version">Version</string>
    <string name="about_body">DRS Smart Keyboard is a 100% offline keyboard. Prediction, auto-correct, swipe decoding and learning all run on deterministic algorithms — a trie dictionary, weighted edit distance, bigram statistics and geometric gesture matching. No machine learning, no network access, no telemetry. Your words never leave your device.</string>
    <string name="about_slogan">Smart by mathematics, not by machines.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">The app requests no network permission. Nothing is uploaded, ever. Learned words and settings live in this app\'s private storage only.</string>

